{
  "_comment": "PhenixCode RAG minimal configuration",
  "_docs": "https://github.com/nesall/embedder_cpp/wiki/configuration",
  "_version": "1.0.0",
  "chunking": {
    "nof_max_tokens": 450,
    "nof_min_tokens": 50,
    "overlap_percentage": 0.2,
    "semantic": true
  },
  "database": {
    "_comment": "For distance_metric use either cosine (default) or l2",
    "distance_metric": "cosine",
    "index_path": "./db_embeddings.index",
    "max_elements": 100000,
    "sqlite_path": "./db_metadata.db",
    "vector_dim": 768
  },
  "embedding": {
    "batch_size": 4,
    "current_api": "bge_base",
    "enabled_providers": [
      "bge_base"
    ],
    "prepend_label_format": "[Source: {}]\n",
    "retry_attempts": 3,
    "timeout_ms": 30000,
    "top_k": 5
  },
  "generation": {
    "auto_router": {
      "enabled": true,
      "classifier": {
        "api_id": "mistral-small",
        "max_tokens": 20,
        "prompt": "Classify the user programming task into exactly one tier:\n[TIER_1_SIMPLE]: quick syntax, single function, lookup, explanation\n[TIER_2_REFACTOR]: multi-file changes, bug fixing, medium edits\n[TIER_3_COMPLEX]: deep architectural reasoning, tricky algorithms, math/threading\nAnswer ONLY with the tag.",
        "temperature": 0.0,
        "timeout_ms": 3500
      },
      "fallback": {
        "_comment": "used on classifier timeout, transport error, or unparseable tag",
        "default_model_id": "deepseek-flash"
      },
      "routing_rules": {
        "tier_1_simple": {
          "direct_model_id": "mistral-small",
          "strategy": "direct"
        },
        "tier_2_refactor": {
          "direct_model_id": "deepseek-flash",
          "strategy": "direct"
        },
        "tier_3_complex": {
          "draft_model_ids": [
            "deepseek-flash",
            "mistral-codestral"
          ],
          "direct_model_id": "deepseek-flash",
          "_strategy": "ensemble",
          "strategy": "direct",
          "synthesizer_model_id": "anthropic-sonnet-5"
        }
      }
    },
    "current_api": "mistral-small",
    "default_max_tokens": 2048,
    "default_max_tokens_name": "max_tokens",
    "default_temperature": 0.1,
    "enabled_providers": [
      "glm-5.3-flash",
      "mistral-small",
      "mistral-codestral",
      "mistral-large-latest",
      "deepseek-flash",
      "kimi-k27-code",
      "grok-4.6",
      "anthropic-sonnet-5"
    ],
    "excerpt": {
      "enabled": true,
      "max_chunks": 15,
      "min_chunks": 3,
      "threshold_ratio": 0.75
    },
    "max_chunks": 7,
    "max_context_tokens": 64000,
    "max_full_sources": 2,
    "max_related_per_source": 3,
    "prepend_label_format": "[Source: {}]\n",
    "timeout_ms": 120000
  },
  "logging": {
    "diagnostics_file": "embedder_d.log",
    "log_to_console": true,
    "log_to_file": true,
    "logging_file": "embedder.log"
  },
  "source": {
    "_comment_project_id": "Leave empty to auto-generate from config path, or set a custom stable project_id",
    "default_extensions": [
      ".c",
      ".cpp",
      ".h",
      ".hpp",
      ".py",
      ".js",
      ".ts",
      ".java",
      ".rs",
      ".cs",
      ".xaml",
      ".php",
      ".jsp",
      ".html",
      ".css",
      ".md"
    ],
    "encoding": "utf-8",
    "global_exclude": [
      "*/node_modules/*",
      "*.min.js",
      "*.log",
      "*/build/*",
      "*/.git/*",
      ".gitignore",
      "*/CVS/*",
      "*/debug/*",
      "*/release/*",
      "*/lib/*",
      "*/docker/*",
      "*/fonts/*",
      "*/images/*",
      "*/test/*",
      "*/tests/*",
      "*/example/*",
      "*/examples/*",
      "*/obj/*",
      "*/build_dbg/*",
      "*/build_rel/*",
      "*/bin/*",
      "*/media/*",
      "*/dist/*",
      "*/public/*",
      "*/test/*",
      "*/3rdparty/*",
      "*/cmake-build/*",
      "*/assets/*",
      "*/.vscode/*",
      "*/.vs/*"
    ],
    "max_file_size_mb": 10,
    "paths": [
      {
        "exclude": [],
        "extensions": [],
        "path": "./src",
        "recursive": true,
        "type": "directory"
      }
    ],
    "project_description": "",
    "project_id": "phenixcode-482a2b6f",
    "project_title": "PhenixCode (test)"
  },
  "tokenizer": {
    "config_path": "./bge_tokenizer.json"
  }
}